# ============================================
# VAULT - Gestion centralisée des secrets
# ============================================
# Pour Docker Compose (depuis le réseau itero-network)
VAULT_ADDR=http://vault:8200
# Pour accès local depuis le host (développement)
# VAULT_ADDR=http://localhost:8200

VAULT_TOKEN=myroot

# ============================================
# MongoDB Configuration
# ============================================
MONGO_USER=itero
MONGO_PASSWORD=your_secure_password_here
MONGO_DB=itero

# ============================================
# Mongo Express Configuration (Admin Panel)
# ============================================
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=your_admin_password_here

# ============================================
# Backend Configuration
# ============================================
NODE_ENV=production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ============================================
# OAuth - GitHub (Optional)
# ============================================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://your-domain.com/auth/github/callback

# ============================================
# OAuth - Google (Optional)
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-domain.com/auth/google/callback

# ============================================
# Anthropic API (Optional - for AI features)
# ============================================
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ============================================
# URLs
# ============================================
FRONTEND_URL=https://your-domain.com
VITE_API_URL=https://your-domain.com/api

# ============================================
# Application Ports
# ============================================
PORT=3000
FRONTEND_PORT=80
VAULT_PORT=8200
